{
  "name": "radix-solid-website",
  "compatibility_date": "2026-09-01",
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash",
    "run_worker_first": ["/case-studies", "/case-studies/*", "/colors/docs", "/colors/docs/*", "/docs/*", "/primitives/docs", "/primitives/docs/*", "/themes", "/themes/docs", "/themes/docs/*", "/blog/*"]
  },
  "workers_dev": false,
  "preview_urls": false
}
